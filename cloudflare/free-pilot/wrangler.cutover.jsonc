{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faculdademaria-free-pilot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "free-pilot.radarpulse.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.radarpulse.com.br/faculdademaria*",
      "zone_name": "radarpulse.com.br"
    }
  ],
  "assets": {
    "directory": "../../static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faculdademaria-pilot",
      "database_id": "84058aa8-f377-40f3-9015-f1e1fc3d71b7"
    }
  ]
}
